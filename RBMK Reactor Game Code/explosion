local meltdown = game.ReplicatedStorage.meltdownEvent
local part = script.Parent

meltdown.Event:Connect(function()
	task.wait(5)
	for i = 1, 30 do
		part.Size = part.Size + Vector3.new(20, 20, 20)
		task.wait(0.02)
	end
end)

part.Touched:Connect(function(hit)
	local hum = hit.Parent:FindFirstChild("Humanoid")
	if hum then
		hum:TakeDamage(100)
	end
end)
