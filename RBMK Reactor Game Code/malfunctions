local coolantPumpMalfunction = game.ReplicatedStorage.Malfunctions.coolantPumpMalfunctionEvent
local coolantPipeLeak = game.ReplicatedStorage.Malfunctions.coolantPipeLeakEvent
local VentilationClog = game.ReplicatedStorage.Malfunctions.VentilationClogEvent
local SCRAMFailure = game.ReplicatedStorage.Malfunctions.SCRAMFailureEvent
local SensorFailure = game.ReplicatedStorage.Malfunctions.SensorFailureEvent
local SensorFailureChance = 10
local numFailures = 0
local timer = 0

task.spawn(function() -- coolant pump malfunction
	task.wait(20)
	while true do
		local rand = math.random(1, 6000)
		local coolantPumpMalfunctionChance = 20 * ( - ( (math.sqrt(5 * numFailures) ) / 5 ) ) + 20
		if rand <= coolantPumpMalfunctionChance then
			coolantPumpMalfunction:Fire()
			numFailures += 1
		end
		task.wait(1)
	end
end)

