task.spawn(function() -- timer
	task.wait(20)
	while true do
		if numFailures > 0 then
			timer = 0
		end
		if numFailures == 0 and timer >= 40 then
			local rand = math.random(1, 9)
			if rand < 2 then
				VentilationClog:Fire()
			elseif rand < 3 then 
				SensorFailure:Fire()
			elseif rand < 5 then
				coolantPumpMalfunction:Fire()
			elseif rand < 7 then
				SCRAMFailure:Fire()
			else
				coolantPipeLeak:Fire()
			end
		end
		timer += 1
		task.wait(1)
	end
end)
